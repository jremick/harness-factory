{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hdp/software-harness-v1.schema.json",
  "title": "HDP software harness definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "kind",
    "metadata",
    "intent",
    "workspace",
    "policy",
    "workflow",
    "verification",
    "assumptions",
    "open_requirements"
  ],
  "properties": {
    "api_version": {"const": "hdp/v1"},
    "kind": {"const": "SoftwareHarness"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "owners"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
        "version": {"type": "string", "minLength": 1},
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "task_file", "non_goals"],
      "properties": {
        "outcome": {"type": "string", "minLength": 1},
        "task_file": {"type": "string", "minLength": 1},
        "non_goals": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_root",
        "writable_paths",
        "prohibited_paths",
        "manual_extension_paths"
      ],
      "properties": {
        "repository_root": {"const": "."},
        "writable_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "prohibited_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "manual_extension_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "external_writes", "secrets", "allowed_executables"],
      "properties": {
        "network": {"enum": ["deny", "allow"]},
        "external_writes": {"const": "deny"},
        "secrets": {"const": "deny"},
        "allowed_executables": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9._+-]+$"}
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_steps", "roles"],
      "properties": {
        "required_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "instruction", "evidence"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
              "instruction": {"type": "string", "minLength": 1},
              "evidence": {"type": "string", "minLength": 1}
            }
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "purpose", "allowed_actions", "forbidden_actions"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
              "purpose": {"type": "string", "minLength": 1},
              "allowed_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "forbidden_actions": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "success_criteria"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "argv", "cwd", "timeout_seconds"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "cwd": {"type": "string"},
              "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600}
            }
          }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "checks"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,62}$"},
              "statement": {"type": "string", "minLength": 1},
              "checks": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "open_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "blocking"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,62}$"},
          "question": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    }
  }
}
