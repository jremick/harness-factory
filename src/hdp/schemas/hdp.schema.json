      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "schemaUri", "schemaDigest", "version", "required", "payload"],
      "properties": {
        "owner": {"$ref": "#/$defs/uri"},
        "schemaUri": {"$ref": "#/$defs/uri"},
        "schemaDigest": {"$ref": "#/$defs/sha256"},
        "version": {"$ref": "#/$defs/semver"},
        "required": {"type": "boolean"},
        "payload": true
      }
    },
    "reconstructionExtension": {
      "oneOf": [
        {"$ref": "#/$defs/reconstructionProjection"},
        {"$ref": "#/$defs/reconstructionEvidence"}
      ]
    },
    "reconstructionProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceMap", "generationReady", "sourceMode"],
      "properties": {
        "evidenceMap": {"$ref": "#/$defs/relativePath"},
        "generationReady": {"type": "boolean"},
        "sourceMode": {"$ref": "#/$defs/text"}
      }
    },
    "reconstructionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generationReady", "inventorySha256", "inventory", "contradictions", "omissions", "fieldAssessments"],
      "properties": {
        "schemaVersion": {"const": "1"},
        "generationReady": {"type": "boolean"},
        "inventorySha256": {"$ref": "#/$defs/reconstructionSha256"},
        "inventory": {"type": "array", "items": {"$ref": "#/$defs/reconstructionInventoryItem"}},
        "contradictions": {"type": "array", "items": {"type": "object"}},
        "omissions": {"type": "array", "items": {"type": "object"}},
        "fieldAssessments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reconstructionFieldAssessment"}}
      }
    },
    "reconstructionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reconstructionInventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "kind": {"$ref": "#/$defs/text"},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/reconstructionSha256"},
        "textCandidate": {"type": "boolean"},
        "inspectable": {"type": "boolean"},
        "inspected": {"type": "boolean"}
      }
    },
    "reconstructionEvidenceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "location", "sha256"],
      "properties": {
        "source": {"$ref": "#/$defs/relativePath"},
        "location": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/reconstructionSha256"}
      }
    },
    "reconstructionFieldAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value", "claimClass", "epistemicStatus", "confidence", "evidence", "contradictions", "missingEvidence", "humanConfirmationRequired"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "value": true,
        "claimClass": {"enum": ["evidenced-intended-outcome", "operational-behavior", "inferred-intent", "administrative-metadata", "absent-or-unknowable"]},
        "epistemicStatus": {"enum": ["observed", "declared", "inferred", "unknown"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/reconstructionEvidenceCitation"}},
        "contradictions": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "missingEvidence": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "humanConfirmationRequired": {"type": "boolean"}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false, "required": ["policy", "breakingChangeRule"],
      "properties": {"policy": {"enum": ["semantic-versioning", "calendar-versioning", "custom"]}, "breakingChangeRule": {"$ref": "#/$defs/text"}}
    },
    "changeControl": {
      "type": "object", "additionalProperties": false, "required": ["owner", "approval", "regressionRequired"],
      "properties": {"owner": {"$ref": "#/$defs/text"}, "approval": {"$ref": "#/$defs/text"}, "regressionRequired": {"type": "boolean"}}
    },
    "deprecation": {
      "type": "object", "additionalProperties": false, "required": ["id", "targetId", "announcedVersion", "removalVersion", "replacement"],
      "properties": {"id": {"$ref": "#/$defs/stableId"}, "targetId": {"$ref": "#/$defs/stableId"}, "announcedVersion": {"$ref": "#/$defs/semver"}, "removalVersion": {"$ref": "#/$defs/semver"}, "replacement": {"$ref": "#/$defs/text"}}
    },
    "limitation": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "impact", "status"],
      "properties": {"id": {"$ref": "#/$defs/stableId"}, "statement": {"$ref": "#/$defs/text"}, "impact": {"$ref": "#/$defs/text"}, "status": {"enum": ["known", "accepted", "planned"]}}
    },
    "risk": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "likelihood", "impact", "treatment", "residual"],
      "properties": {"id": {"$ref": "#/$defs/stableId"}, "statement": {"$ref": "#/$defs/text"}, "likelihood": {"enum": ["low", "medium", "high"]}, "impact": {"enum": ["low", "medium", "high", "critical"]}, "treatment": {"$ref": "#/$defs/text"}, "residual": {"$ref": "#/$defs/text"}}
    },
    "relativePath": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:/|~|.*(?:^|/)\\.\\.(?:/|$))"}}
  }
}
