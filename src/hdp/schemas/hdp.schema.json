      "type": "object", "additionalProperties": false, "required": ["id", "type", "version", "conformance"],
      "properties": {"id": {"$ref": "#/$defs/slug"}, "type": {"enum": ["codex-software-development", "agent-spec", "custom"]}, "version": {"$ref": "#/$defs/semver"}, "conformance": {"enum": ["core", "development", "controlled", "production", "high-assurance"]}}
    },
