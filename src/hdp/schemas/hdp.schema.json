    },
    "driftRule": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "measureId", "response"],
      "properties": {"id": {"$ref": "#/$defs/stableId"}, "statement": {"$ref": "#/$defs/text"}, "measureId": {"$ref": "#/$defs/stableId"}, "response": {"enum": ["alert", "re-evaluate", "rollback", "suspend"]}}
    },
    "alert": {
      "type": "object", "additionalProperties": false, "required": ["id", "statement", "owner"],
      "properties": {"id": {"$ref": "#/$defs/stableId"}, "statement": {"$ref": "#/$defs/text"}, "owner": {"$ref": "#/$defs/text"}}
    },
    "traceNode": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "ref"],
      "properties": {"id": {"$ref": "#/$defs/stableId"}, "kind": {"enum": ["outcome", "requirement", "component", "test", "evidence", "risk", "control", "decision"]}, "ref": {"$ref": "#/$defs/stableId"}}
    },
    "traceEdge": {
      "type": "object", "additionalProperties": false, "required": ["id", "from", "relation", "to"],
      "properties": {"id": {"$ref": "#/$defs/stableId"}, "from": {"$ref": "#/$defs/stableId"}, "relation": {"enum": ["decomposedInto", "implementedBy", "verifiedBy", "validatedBy", "produces", "mitigates", "supports", "refutes", "supersedes"]}, "to": {"$ref": "#/$defs/stableId"}}
    },
